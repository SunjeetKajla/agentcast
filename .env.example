# Copy to .env. The worker and CLI load it, and its values win over your shell's.

# Required
TINYFISH_API_KEY=
ELEVENLABS_API_KEY=

# Voices (free plan falls back to premade Bella / Brian)
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_HI=
ELEVENLABS_CONCURRENCY=2

# Worker
AGENTCAST_HOME=~/.agentcast
WORKER_URL=http://127.0.0.1:4000
# Seals signed-in sessions; without it a random key is made once in ~/.agentcast/secret.key
AGENTCAST_SECRET=

# LLM backend: uses your logged-in coding-agent CLI, no API key needed (PRD §9.9)
AGENTCAST_LLM=auto             # auto | claude-code | opencode | codex | anthropic-api
AGENTCAST_LLM_SMART=           # optional backend override for director + script
AGENTCAST_LLM_FAST=            # optional backend override for brief, judge, healing
AGENTCAST_LLM_SMART_MODEL=     # optional; claude-code default "opus"; codex built-in default
AGENTCAST_LLM_FAST_MODEL=      # optional; claude-code default "haiku"; codex built-in default
AGENTCAST_LLM_CONCURRENCY=2
AGENTCAST_DIRECTOR=            # "off" skips the Claude Code director (baseline edit is used)
ANTHROPIC_API_KEY=             # optional, only used when AGENTCAST_LLM=anthropic-api
