{
  "name": "agentcast",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:worker": "pnpm --filter @agentcast/worker dev",
    "typecheck": "pnpm -r --parallel --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
